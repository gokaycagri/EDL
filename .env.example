# Threat Feed Aggregator Environment Variables
# Rename this file to .env and fill in the values

# Flask Secret Key (REQUIRED for production)
# Generate: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=change_this_to_a_very_secure_random_string

# Initial Admin Password (Used only on first run to set up the admin user)
ADMIN_PASSWORD=change_me_please

# Port (Default: 8080)
PORT=8080

# Debug mode (set to 1 for development only, never in production)
# FLASK_DEBUG=0

# Database (default: sqlite)
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=threat_feed
# DB_USER=threat_user
# DB_PASS=

# Redis (optional, for distributed sessions)
# REDIS_HOST=redis
# REDIS_PORT=6379

# ITAI Hub SSO Integration (optional)
# ITAI_MODE=true
# ITAI_JWT_SECRET=your_jwt_secret_here
