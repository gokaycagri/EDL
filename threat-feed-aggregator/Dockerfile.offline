FROM quay.mfa.gov.tr/admin/threat-feed-aggregator:latest
USER root
COPY . .
RUN chgrp -R 0 /app && chmod -R g=u /app && chmod +x /app/entrypoint.sh

# HTTP-first healthcheck: FORCE_HTTP_MODE=true ortamında HTTPS beklenmez.
# curl önce HTTP dener, başarısız olursa HTTPS dener (self-signed için -k).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -sf http://localhost:8080/health || curl -sfk https://localhost:8080/health || exit 1

USER 1001
